// Privacy Policy
"privacy.title" = "Privacy Policy";
"privacy.done" = "Done";
"privacy.lastUpdated" = "Last updated: October 3, 2026";
"privacy.introduction.title" = "Introduction";
"privacy.introduction.content" = "Tabiin Academy respects your privacy and is committed to protecting your personal data. This privacy policy explains how we collect, use, and protect your information when using our app.";
"privacy.collection.title" = "Information Collection";
"privacy.collection.content" = "The app stores only the data it needs to work:\n\n• Learning statistics, progress, quiz and exam history, achievements\n• App settings (language, sound, notifications)\n\nIf you use Sign in with Apple, the app also stores:\n\n• Your Apple user identifier, to sync between your devices\n• Your name, if you chose to share it when signing in, and your display name, if you set one\n• Your profile photo, if you chose one (the app only receives the image you select)\n\nThe app does not request your email or phone number and does not use analytics, ads, or tracking.";
"privacy.usage.title" = "Data Usage";
"privacy.usage.content" = "Data is used only to:\n\n• Show your learning progress and profile\n• Select questions and review mistakes\n• Sync your progress between your devices (when signed in with Apple)\n• Send study reminders (if you turned them on)";
"privacy.storage.title" = "Data Storage";
"privacy.storage.content" = "Data is stored on your device. When you use Sign in with Apple, your profile (identifier, name, photo, and progress) is stored in your private iCloud database (Apple CloudKit). The developer has no servers of its own and no access to this data. We do not share your data with third parties.";
"privacy.thirdParty.title" = "Third Party Services";
"privacy.thirdParty.content" = "The app uses:\n\n• Apple: Sign in with Apple, iCloud (CloudKit), system notifications, and the App Store\n• GitHub, to download question bank updates. Requests include only technical data, as when opening any web page (for example, your IP address); no data about you or your progress is sent\n\nThese services follow their own privacy policies.";
"privacy.rights.title" = "Your Rights";
"privacy.rights.content" = "You can:\n\n• View your data in your profile\n• Reset your statistics and progress in your profile\n• Delete your account in your profile: your profile is deleted from iCloud and from the device, along with your photo, statistics, and progress\n• Disconnect the app from your Apple ID: Settings → [your name] → Sign-In & Security → Sign in with Apple\n• Turn off notifications at any time\n• Delete the app — all data on the device will be removed";
"privacy.contact.title" = "Contact Information";
"privacy.contact.content" = "If you have questions about this privacy policy, contact us:\n\nEmail: saydulayev.wien@gmail.com";
"privacy.changes.title" = "Policy Changes";
"privacy.changes.content" = "We may update this privacy policy. We will notify you of any changes through app updates.";

