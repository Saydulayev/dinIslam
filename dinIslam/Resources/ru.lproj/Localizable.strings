// Privacy Policy
"privacy.title" = "Политика конфиденциальности";
"privacy.done" = "Готово";
"privacy.lastUpdated" = "Последнее обновление: 3 октября 2026 г.";
"privacy.introduction.title" = "Введение";
"privacy.introduction.content" = "Tabiin Academy уважает вашу конфиденциальность и стремится защитить ваши личные данные. Данная политика конфиденциальности объясняет, как мы собираем, используем и защищаем вашу информацию при использовании нашего приложения.";
"privacy.collection.title" = "Сбор информации";
"privacy.collection.content" = "Приложение хранит только данные, необходимые для его работы:\n\n• Статистика обучения, прогресс, история викторин и экзаменов, достижения\n• Настройки приложения (язык, звук, уведомления)\n\nЕсли вы входите через «Вход с Apple», дополнительно хранятся:\n\n• Идентификатор пользователя Apple — для синхронизации между вашими устройствами\n• Имя, если вы разрешили его передать при входе, и отображаемое имя, если вы его указали\n• Фото профиля, если вы его выбрали (приложение получает только выбранное вами изображение)\n\nПриложение не запрашивает email и телефон, не использует аналитику, рекламу и отслеживание.";
"privacy.usage.title" = "Использование данных";
"privacy.usage.content" = "Данные используются только для:\n\n• Отображения вашего прогресса обучения и профиля\n• Подбора вопросов и повторения ошибок\n• Синхронизации прогресса между вашими устройствами (при входе через Apple)\n• Напоминаний о занятиях (если вы их включили)";
"privacy.storage.title" = "Хранение данных";
"privacy.storage.content" = "Данные хранятся на вашем устройстве. При входе через «Вход с Apple» профиль (идентификатор, имя, фото и прогресс) сохраняется в вашей личной базе iCloud (Apple CloudKit). У разработчика нет собственных серверов и нет доступа к этим данным. Мы не передаём ваши данные третьим лицам.";
"privacy.thirdParty.title" = "Сторонние сервисы";
"privacy.thirdParty.content" = "Приложение использует:\n\n• Apple: «Вход с Apple», iCloud (CloudKit), системные уведомления и App Store\n• GitHub — для загрузки обновлений банка вопросов. При запросе передаются только технические данные, как при открытии любой веб-страницы (например, IP-адрес); никаких данных о вас и вашем прогрессе не отправляется\n\nЭти сервисы действуют по своим политикам конфиденциальности.";
"privacy.rights.title" = "Ваши права";
